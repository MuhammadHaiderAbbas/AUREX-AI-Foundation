# Copy to .env.prod. Non-secret settings only: secrets live in ./secrets/ (see make-secrets.sh).
AUREX_DOMAIN=aurex.example.com
AUREX_IMAGE_OWNER=your-github-user
AUREX_VERSION=v1.0.0
AUREX_ALLOW_REGISTRATION=false
AUREX_MARKET_DATA_MODE=live
# AUREX_AUDIT_ANCHOR_WEBHOOK_URL=https://anchors.example.org/aurex
BACKUP_AT=02:15
DRILL_WEEKDAY=7
BACKUP_RETENTION_DAYS=14
# BACKUP_GPG_RECIPIENT=ops@example.com
