# Copy to .env and adjust. Never commit .env.
AUREX_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUREX_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
AUREX_COOKIE_SECURE=false
AUREX_ALLOW_REGISTRATION=true
AUREX_ACCESS_TOKEN_TTL_MINUTES=15
AUREX_REFRESH_TOKEN_TTL_DAYS=7
POSTGRES_PASSWORD=aurex
# For running the backend natively against the compose database:
# AUREX_DATABASE_URL=postgresql+asyncpg://aurex:aurex@localhost:5432/aurex
